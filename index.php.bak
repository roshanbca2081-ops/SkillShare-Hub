<?php
/**
 * SkillShare Hub - Landing Page
 * The main entry point for the platform
 */

// Start session
session_start();

// Include configuration
require_once 'config/config.php';
require_once 'config/database.php';
require_once 'includes/functions.php';
require_once 'includes/session.php';

// Check if user is logged in
if (isLoggedIn()) {
    redirectToDashboard($_SESSION['user_role']);
}

// Get statistics
$totalGraduates = getCount('users', "role = 'graduate' AND status = 'active'");
$totalFreshers = getCount('users', "role = 'fresher' AND status = 'active'");
$totalSkills = getCount('practical_skills', "status = 'approved'");
$totalSessions = getCount('mentorship_sessions', "status = 'completed'");

// Get featured graduates
$featuredGraduates = getRecords("
    SELECT u.id, u.full_name, u.profile_picture, u.bio, u.hourly_rate,
           AVG(r.rating) as avg_rating, COUNT(r.id) as review_count
    FROM users u
    LEFT JOIN reviews r ON r.reviewee_id = u.id
    WHERE u.role = 'graduate' AND u.status = 'active'
    GROUP BY u.id
    ORDER BY avg_rating DESC
    LIMIT 6
");

// Get recent skills
$recentSkills = getRecords("
    SELECT ps.*, u.full_name, u.profile_picture
    FROM practical_skills ps
    JOIN users u ON u.id = ps.user_id
    WHERE ps.status = 'approved'
    ORDER BY ps.created_at DESC
    LIMIT 6
");

// Get academic fields
$academicFields = getRecords("
    SELECT id, field_name, field_slug, description
    FROM academic_fields
    WHERE status = 'active'
    ORDER BY sort_order ASC
    LIMIT 8
");

include 'includes/header.php';
?>

